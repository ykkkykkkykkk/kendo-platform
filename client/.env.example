# Cloudinary — 선수 프로필 사진 업로드에 필요
VITE_CLOUDINARY_CLOUD_NAME=dnsbillj0
VITE_CLOUDINARY_UPLOAD_PRESET=kendo-players

# 현재 카카오 로그인 비활성화 상태 — 배포 직전 아래 키 추가 후 재활성화
# VITE_KAKAO_APP_KEY=your_kakao_javascript_key_here

# ── 모니터링 (선택) ──
# 둘 다 비워두면 아무것도 로드되지 않는다. 프로덕션 빌드에서만 동작한다.
# Sentry: sentry.io → 프로젝트 생성(React) → Client Keys(DSN)에서 복사
# VITE_SENTRY_DSN=https://xxxxxxxx@oNNNNNN.ingest.sentry.io/NNNNNNN
# GA4: analytics.google.com → 관리 → 데이터 스트림 → 웹 → 측정 ID(G-로 시작)
# VITE_GA_ID=G-XXXXXXXXXX
